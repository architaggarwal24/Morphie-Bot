{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morphie-bot",
  "main": "src/worker.py",
  // Python Workers need a recent date and the python_workers flag.
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["python_workers"],
  "observability": { "enabled": true },

  // The chat page and its JS/CSS are served straight from Cloudflare's edge (public/ is generated by
  // scripts/build_public.py and committed). Everything else (/chat, /documents, /status ...) reaches Flask.
  "assets": { "directory": "./public" },

  // Non-secret settings. The only secret you must set is FLASK_SECRET_KEY: `uv run pywrangler secret put FLASK_SECRET_KEY`.
  // There is deliberately NO server-side LLM provider or API key: every visitor picks a provider and enters their
  // own key in the page's Settings (bring your own key). The key stays in their browser, goes to the model with
  // their messages, and is never stored or logged by the Worker.
  "vars": {
    "SESSION_COOKIE_SECURE": "true",
    "RAG_MAX_UPLOAD_SIZE_MB": "10",
    "MAX_TOOL_CALLS": "5"
    // Optional: "TAVILY_API_KEY" (a secret, not a var) turns on the web-search tool for everyone; "TRUSTED_ORIGINS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "morphie-bot",
      // Replace with the id printed by `uv run pywrangler d1 create morphie-bot`.
      "database_id": "055aa037-3a7a-4aca-b6de-6cfa7de31c98",
      "migrations_dir": "migrations"
    }
  ]
}
