# ============================================================================
# Morphie-Bot configuration.
#
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# then edit .env. The only thing you MUST set is the API key for the provider
# you pick below (or none at all if you use Ollama). `.env` is gitignored -
# never commit it.
# ============================================================================

# ---- Which AI model answers ------------------------------------------------
# One of: mistral | openai | ollama
LLM_PROVIDER=mistral
# Optional: override the provider's default model (leave blank for the default).
#   mistral -> mistral-large-latest   openai -> gpt-4o-mini   ollama -> llama3.1
LLM_MODEL=

# Set the key for the provider you chose. Ollama needs no key.
MISTRAL_API_KEY=
OPENAI_API_KEY=
# Where your local Ollama server listens (only used when LLM_PROVIDER=ollama).
OLLAMA_BASE_URL=http://localhost:11434

# ---- Tools -----------------------------------------------------------------
# Hard cap on tool round-trips in a single turn (prevents tool-call loops).
MAX_TOOL_CALLS=5
# Enables real web_search results via Tavily (free key at https://tavily.com).
# Blank is fine: the tool then tells the agent live search isn't configured.
TAVILY_API_KEY=

# ---- Server ----------------------------------------------------------------
# Signs the session cookie, which is what identifies a browser (and therefore
# its documents). LEAVE BLANK to have a strong random key generated once and
# stored in SECRET_KEY_FILE (fine for one machine), or set your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
SECRET_KEY_FILE=data/.flask_secret
# Where `python app.py` listens. Defaults are safe: localhost only, no debugger.
HOST=127.0.0.1
PORT=5000
# Werkzeug's debugger lets anyone who can reach the server run code.
# Development only, and never on a machine other people can reach.
FLASK_DEBUG=false
# Set to true when serving over HTTPS so the session cookie is never sent over HTTP.
SESSION_COOKIE_SECURE=false
# Extra origins allowed to make state-changing requests (needed only if a reverse
# proxy makes the browser's Origin differ from the Host header). Comma-separated.
TRUSTED_ORIGINS=

# ---- Limits ----------------------------------------------------------------
# Longest chat message accepted, in characters.
MAX_MESSAGE_CHARS=8000
# How many recent messages are kept as conversation context (in memory).
MAX_CONTEXT_MESSAGES=20
# Rate limits per user (and, more loosely, per IP). 0 disables one limit;
# RATE_LIMIT_ENABLED=false disables all. In-memory, per process.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# ---- Documents (RAG) -------------------------------------------------------
# Uploaded files and the search index. Never committed (see .gitignore).
RAG_UPLOAD_DIR=data/documents
RAG_VECTOR_STORE_PATH=data/vector_store/rag.sqlite3
# Reject uploads larger than this (checked against the bytes actually read).
RAG_MAX_UPLOAD_SIZE_MB=20
# Reject documents that would need more chunks than this (~2000 chunks is roughly
# 1.5-2 million characters), so one huge file can't monopolise the embedder.
RAG_MAX_CHUNKS_PER_DOCUMENT=2000
# Chunking: character-based, word-boundary-respecting.
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# Chunks retrieved per question, and the minimum similarity (0-1) to count.
RAG_TOP_K=5
RAG_MIN_SCORE=0.15
# Offline hashing embedding: no API calls, no downloads. Dimension of the vectors.
RAG_LOCAL_EMBEDDING_DIM=384
